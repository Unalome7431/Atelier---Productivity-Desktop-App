# =========================================================================
# Atelier Server & Database Environment Configuration
# =========================================================================

# Database Credentials
POSTGRES_DB=atelier
POSTGRES_USER=atelier_user
POSTGRES_PASSWORD=generate_a_secure_password_here

# Internal container networking (leave host as 'postgres')
DATABASE_URL=postgres://atelier_user:generate_a_secure_password_here@postgres:5432/atelier

# API Port & Secret Sync Key (Used by Desktop Client & Telegram Worker)
PORT=3001
SYNC_API_KEY=generate_a_secure_token_here
